# SkillBridge AI Backend Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development

# JWT Authentication
SECRET_KEY=skillbridge_super_secret_jwt_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Configuration
# Set your MongoDB Atlas connection string here:
# MONGODB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/skillbridge_db?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=skillbridge_db

# AI Engine (Groq API)
# Get your free Groq API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# CORS Origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

